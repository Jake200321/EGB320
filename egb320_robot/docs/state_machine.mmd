%% Keep in sync with egb320/navigation/state_machine.py — paste into mermaid.live to render.
stateDiagram-v2
  [*] --> BOOT
  BOOT --> WAIT_FOR_GO : sensors OK
  WAIT_FOR_GO --> EXPLORE : go  %% TODO: which signal?
  EXPLORE --> APPROACH : victim marker, N frames (Vision)
  APPROACH --> COLLECT : range <= 10 cm (Vision)
  APPROACH --> EXPLORE : marker lost N frames
  COLLECT --> RETURN : DONE + has_victim (Rescue)
  COLLECT --> APPROACH : FAILED [retries left]
  RETURN --> DELIVER : at base (Nav map)
  DELIVER --> EXPLORE : DONE [victims remain]
  DELIVER --> FINISHED : [all delivered or time low]
  %% TODO CLEAR_RUBBLE (L3) — hook in where?
  %% TODO RECOVER — entered from which driving states?
  %% TODO time-low superstate: t >= 6:30 -> RETURN (carrying) / ... (empty)
  note right of EXPLORE
    LED yellow · frontier exploration
    map: cells, walls, dead ends, hazards
  end note
